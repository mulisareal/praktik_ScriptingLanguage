# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN upload file .env ke GitHub.

# Token dari @BotFather (wajib)
BOT_TOKEN=isi_token_dari_BotFather

# ID Telegram admin, untuk perintah /perbarui (opsional; cek ID lewat @userinfobot)
ADMIN_ID=

# Jam pengiriman kutipan harian untuk pelanggan (format 24 jam)
JAM_KIRIM=07:00
